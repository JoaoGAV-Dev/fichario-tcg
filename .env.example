# Copie para .env e preencha. Variáveis EXPO_PUBLIC_ vão dentro do app (não coloque segredos de servidor aqui).

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Chave grátis do OCR.space (https://ocr.space/ocrapi/freekey) — liga o scanner pela câmera
EXPO_PUBLIC_OCR_SPACE_KEY=
